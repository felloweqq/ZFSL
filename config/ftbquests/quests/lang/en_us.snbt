	chapter.1A65771DC3681B35.title: "Odznaczenia"
	chapter.4EFCA8D8F6B1C1BD.title: "Magazyn"
	chapter.51571A25C334DBAD.title: "Teleportacja"
	chapter.55153E1C2E4328FE.title: "Gotowanie"
	chapter.57AE4ECB6307EA55.title: "Walki żuli"
	chapter.5CDCE2839EABB519.title: "Wędkarstwo"
	chapter.7AC29D0BD6F5D2C1.title: "The End"
	chapter.7F87C18D7D4699ED.title: "Rytuały i Inkantacja"
	quest.001848EE79FD0CF5.quest_desc: ["&o&#189502Rozwidlenia w prawo to (od góry): dekoracje/budowanie; temperatura; ekspolarcja. Z lewej: uzbrojenie, kopanie, PvE"]
	quest.001848EE79FD0CF5.quest_subtitle: "Stwórz kamienny kilof. Zauważ, że questy rozwidlają się w konkretny sposób."
	quest.001848EE79FD0CF5.title: "Daj kamienia"
	quest.00EE5AD5D987CB11.quest_subtitle: "Spirytus przynajmniej byłby sterylny. Dopuść się absolutnej herezji i wyprodukuj \"Withering Dross\"."
	quest.00EE5AD5D987CB11.title: "Męski drink"
	quest.010F98569467F5B3.quest_subtitle: "Nadal płonące ogniem piekielnym. Znalezione w Fortecy."
	quest.01231E0B919B238D.quest_subtitle: "Wyłów coś niezbyt drewnianego jak na pudło."
	quest.0260C72E8418AE57.quest_subtitle: "Pokonaj Golem of Last Resort - strażnika Pillagerów wysyłanego przez nich na raidach wywołanych Bad Omen trzeciego poziomu."
	quest.0260C72E8418AE57.title: "Żelazny immunitet"
	quest.028DD3CC9F3E40CD.quest_subtitle: "Stwórz Exo Helmet."
	quest.029A7FD24BE04401.quest_subtitle: "Przeżyj 6 tygodni bez śmierci. (in-game)"
	quest.029A7FD24BE04401.title: "Niezłomny"
	quest.0344701825382D3A.quest_desc: ["&o&#189502Postaw go, kliknij na niego prawym przyciskiem myszy trzymając rdzeń (Machine Cores), po czym kliknij po raz drugi by zbudować maszynę. Podłącz do niego przewody poprowadzone z Generatora, żeby dać mu dostęp do prądu."]
	quest.0344701825382D3A.quest_subtitle: "Stwórz Powered Furnace. Jego funkcja jest raczej oczywista - przepalisz w nim cokolwiek, w znacznie szybszym tempie."
	quest.0344701825382D3A.title: "Efektywność z efektownością"
	quest.038018A5A359F4C9.quest_desc: ["&o&#189502Stary, mógłbyś poświęcić tą dedykację na budowaniu perfekcyjnej repliki Tilded Towers, albo przynajmniej Barszczańskiej. "]
	quest.038018A5A359F4C9.quest_subtitle: "Stwórz cały zestaw badawczy do ustanowienia czy karasie rzeczywiście jedzą gówno."
	quest.038018A5A359F4C9.title: "Fanatyk"
	quest.0388D9AF411E0A42.quest_desc: [
		"&o&#189502Dzięki tej lampie temperatura w Netherze nie powinna sprawiać żadnego problemu. Na start możesz zasilić ją otrzymaną nagrodą, jednak jak najszybciej udaj się na tereny w których występują piaski dusz, by zdobyć Soul Sprout. Możesz hodować je również w Overworld (domyślny wymiar). Lawa może wspomóc ich rozwój."
		""
		"&o&e*Soul Sprout nie jest wymagany do ukończenia questa."
	]
	quest.0388D9AF411E0A42.quest_subtitle: "Stwórz Soulspring Lamp."
	quest.03C6F9FF8D3F7046.quest_subtitle: "Naucz się trochę samodzielności. Przeczytaj nazwę przedmiotu, przytrzymaj LAlt najeżdzając na niego i wyprowadź się w końcu z domu rodzinnego."
	quest.03C6F9FF8D3F7046.title: "Domyśl się"
	quest.03F892CF10052F70.quest_subtitle: "Zmontuj swój pierwszy zestaw małego hazardzisty (maszynę z figurkami kolekcjonerskimi)."
	quest.03F892CF10052F70.title: "Kurwa, przecież już złapało"
	quest.04452656C70907C2.quest_subtitle: "Stwórz parę przedmiotów z moda @Supplementaries, który łączy estetyczne z pożytecznym i odznacza się bardzo kreatywnym podejściem do zawartości, którą dodaje. Wspinaj się po linach; trzymaj swoje jedzenie w kompaktowym koszyku; łap dziecięce wersje mobów zwierzęta do klatki, albo stwórz flet, który możesz przypisać do swoich zwierząt (kilku na raz) by przywołać je z dystansu (max 200 kratek)."
	quest.04452656C70907C2.title: "Wszystkiego po trochu"
	quest.052E27C70F3F3CE8.quest_subtitle: "Rozmnóż 125 zwierząt."
	quest.052E27C70F3F3CE8.title: "Pasterz"
	quest.062013B6879A79CA.quest_subtitle: "Istnieje niska szansa na zdobycie go przy każdej próbie enchantowania."
	quest.06909C5A2625FBC9.quest_desc: [
		"&o&#189502Ta maszyna używana jest między innymi w automatyzacji, ale co interesuje cię teraz najbardziej to pozyskiwania Fluxite, który będzie wymagany, jeśli chcesz pozyskać jeszcze więcej z wykopanych minerałów."
		""
		"&o&e*Target Designator nie jest wymagany do ukończenia questa."
	]
	quest.06909C5A2625FBC9.quest_subtitle: "Stwórz Enderic Laser."
	quest.06B0C0B9437BDE77.quest_subtitle: "Wejdź na płonącą arenę by ostudzić zapał Ignisa."
	quest.06B0C0B9437BDE77.title: "Ice bucket challenge"
	quest.06C7B869A79DBA54.quest_desc: ["&o&#189502Domyślnie, po nałożeniu plecaka, kliknij ` i nakieruj na plecak, by otworzyć odpowiedni interfejs. Otwieranie plecaka możesz też zbindować pod konkretny guzik, jeśli tak będzie ci wygodniej."]
	quest.06C7B869A79DBA54.quest_subtitle: "Stwórz jakąkolwiek część żelaznej zbroi. Plecak ulepszysz kosztem xp'a."
	quest.06C7B869A79DBA54.title: "Żelazna wątroba"
	quest.0787C0511DE8ADA0.quest_subtitle: "Bezrefleksyjnie skomentuj \"koń zwalony\" widząc zdjęcie nie lada urodziwej dziewki."
	quest.0787C0511DE8ADA0.title: "Zajebisty atrament, stary"
	quest.07ACBCD4C95B5683.quest_subtitle: "Rozlej sos pomidorowy na swój kawał placka."
	quest.07ACBCD4C95B5683.title: "Nie używaj ketchupu"
	quest.083D5D47015E48F4.quest_subtitle: "Wyłów coś bardziej drewnianego od ryby."
	quest.083D5D47015E48F4.title: "Przemyt wodny"
	quest.089DE9E57C08EBA7.quest_desc: ["&o&#189502Pierwsze posłuży ci do pasywnego tworzenia Chrononu, drugie będzie niezbędne byś był w stanie go jakoś przetrzymywać. Posiadanie dwóch generatorów na raz doprowadzi do zakłóceń sygnału i uniemożliwi funkcjonowanie obydwu z nich."]
	quest.089DE9E57C08EBA7.quest_subtitle: "Kompletna podstawa moda: stwórz Chronon Generator i Chronon Cell."
	quest.089DE9E57C08EBA7.title: "Pierwsze wynalazki"
	quest.091A9E1A46EC7036.quest_desc: ["&o&#189502By nadać pinezce nazwę, przytrzymaj LShift w trakcie umieszczania jej. Usuniesz pinezki przytrzymując LShift i najeżdzając na X'a przy odpowiedniej pinezce z listy."]
	quest.091A9E1A46EC7036.quest_subtitle: "Użyj książki, rozpisanej mapy oraz klejącego dodatku by stworzyć Atlas. Dołączaj do niego nowe mapy oraz zostawiaj pinezki w istotnych miejscah, by nigdy więcej nie zgubić się w podróży."
	quest.09BB26EF5A768E43.quest_desc: ["&o&#189502Enchanted Ash to proch, którego nieumarli nie są wtanie przejść, co pomoże ci ich uwięzić."]
	quest.09BB26EF5A768E43.quest_subtitle: "Do swojego pierwszego rytuału będziesz potrzebował ofiar. Połóż mączkę kostną na Brazier i po sztuce redstone'a na Stone Hand. Gdy uda ci się zwabić nieumarłych wystarczająco blisko użyj zapalniczki na Brazierze i oglądaj jak zamieniają się w zaledwie cząstkę duszy."
	quest.09BB26EF5A768E43.title: "Trochę magii"
	quest.0A4E95AABD7E3D2E.quest_subtitle: "Kolejna machina pomagająca wyciągnąć więcej ze zdobytych materiałów oraz niezbędna do stworzenia kilku nowych."
	quest.0AB4D66F273FEBCB.quest_subtitle: "Zabij wykształconego zombiaka oraz stwórz z niego przenośny workbench."
	quest.0AB4D66F273FEBCB.title: "5Head"
	quest.0AD6D7C2D60DB176.quest_subtitle: "Daj Ars Ecclessia wiedźmie by poprowadziła cię w stronę mroku. Niezbędne do modlitw kierowanych do bóstw mroku."
	quest.0AD6D7C2D60DB176.title: "Spraw żebym zakasłał 3 razy zanim doliczę do pięciu"
	quest.0B1042A6DAF1B191.quest_subtitle: "Dodaj trochę pikanterii do swoich wycieczek wędkarskich; złów po jednym z najspospolitszych gatunków preferujących lawę - konkretnie tą w Netherze."
	quest.0B1042A6DAF1B191.title: "Hot Ones"
	quest.0B6A4F191B361F2D.quest_subtitle: "Przejęte i przechowywane przez Piglinów."
	quest.0BCF556C26B07F6E.quest_subtitle: "Każdy ma jakieś hobby. Stwórz wędkę."
	quest.0BCF556C26B07F6E.title: "Najlepszy przyjaciel człowieka"
	quest.0C8707BD97091189.quest_subtitle: "Stwórz pełen stack czarnej kawy."
	quest.0C8707BD97091189.title: "Koneser"
	quest.0C909DDD8A3A91DB.quest_subtitle: "Dokonaj 300 transakcji."
	quest.0C909DDD8A3A91DB.title: "Lichwiarz"
	quest.0CA39F8A70DD103A.quest_subtitle: "Zdobądź swój pierwszy diament."
	quest.0CA39F8A70DD103A.title: "Pierwszy z wielu"
	quest.0D407BC4E2457D55.quest_desc: ["&o&#189502Paczka zawiera również @Eidolon:Edoni, czyli dodatek na mnóstwo nowego jedzenia w tym samym klimacie, więcej o nim w zakładce \"Gotowanie\"."]
	quest.0D407BC4E2457D55.quest_subtitle: "@Eidolon:Repraised to mod skupiający się wokół magii i rytuałów. Zawiera dużo interesujących i przydatnych akcesoriów."
	quest.0D407BC4E2457D55.title: "3 6"
	quest.0E636312FC7208F7.quest_subtitle: "Pozyskiwane poprzez zabicie Elder Guardiana."
	quest.0EDC4AC8C35C384D.quest_desc: ["&o&#189502Spróbuj położyć na niej np. blok ametystu i skruszyć go kilofem.&r&r"]
	quest.0EDC4AC8C35C384D.quest_subtitle: "Stwórz deskę do krojenia - atrybut użyteczny nie tylko do krojenia warzyw i mięsa [nożem]. "
	quest.0EDC4AC8C35C384D.title: "Oddawaj fartucha"
	quest.0F043F0E3B24CAF6.quest_desc: ["&#189502&oDwa bloki tego samego koloru musisz postawić w tej samej linii pionowej, wtedy klikając spację \"wjedziesz\" piętro wyżej, z kolei kucając - niżej. Opcja \"Directional\" ustawia kierunek w który użytkownik windy będzie skierowany po teleportacji."]
	quest.0F043F0E3B24CAF6.quest_subtitle: "Stwórz prostą windę, czyli w zasadzie teleporter, który pozwoli ci na swobodniejsze poruszanie po piętrowych budynkach."
	quest.0F043F0E3B24CAF6.title: "Jest mod na ruchome schody?"
	quest.0F117E2CD0882712.quest_subtitle: "Stwórz Chronon Battery i Chronometer. Jest to przenośny magazyn Chrononu i jego generator w ulepszonym wydaniu."
	quest.0F117E2CD0882712.title: "Rewolucja w branży"
	quest.0F224D27E06D41B7.quest_subtitle: "Lecz jego walka trwa dalej. Stwórz naszyjnik, który zrobi z ciebie kruchliwą, choć potężną bestię."
	quest.0F224D27E06D41B7.title: "Kto nie ryzykuje, ten przeżywa..."
	quest.0F8794140B1AB9EC.quest_desc: ["&o&#189502Gwarantowany drop."]
	quest.0F8794140B1AB9EC.quest_subtitle: "Zmuś Evokera do zejścia z wierzchowca bezpośrednio do Hadesu. Zbierz to, co z niego zostanie."
	quest.0F8794140B1AB9EC.title: "Rozbity taran"
	quest.0FD25BBF4008124F.quest_desc: ["&o&#189502Najbardziej skomplikowana maszyna zawarta w questach (przynajmniej jeśli mówimy o zdobyciu jej). Pozwoli ci na wydobycie jeszcze więcej z wydobytych surowców, ale jej głównym zastosowaniem jest stworzenie komponentów niezbędnych do dalszej progresji w modzie."]
	quest.0FD25BBF4008124F.quest_subtitle: "Now, I have become Death, the destroyer of worlds. Stwórz Atomic Forge."
	quest.0FD25BBF4008124F.title: "Send nukes"
	quest.0FE02C49E9F28A85.quest_desc: ["&o&#189502Jeśli chciałbyś używać jej skrótem klawiszowym, nałóż ją na slot paska i przypisz klawisz wedle uznania (kategoria \"Ender Chests\"."]
	quest.0FE02C49E9F28A85.quest_subtitle: "Stwórz przenośną wersję Ender Chesta - Ender Pouch."
	quest.11A83090F710991E.quest_subtitle: "Pokonaj Ancient Knighta. Pudzian prawdopodobnie już kiedyś się z nim zmierzył."
	quest.11A83090F710991E.title: "Tanio skóry nie sprzedam"
	quest.11E7AB44E44C6BDA.quest_desc: ["&o&#18950212,5% na ofertę."]
	quest.11E7AB44E44C6BDA.quest_subtitle: "Traf na unikalną ofertę wędrowcy i odkup od niego wzór Myth."
	quest.11E7AB44E44C6BDA.title: "Oferta specjalna"
	quest.11F3D55DB0663504.quest_desc: [
		"&o&#189502Żeby wytworzyć energię musisz posiłkować się generatorami z @Oritech - najprostszym będzie basic generator zasilany m.in. na węgiel lub drewno."
		""
		"&o&e*druga i trzecia pozycja nie jest wymagana do ukończenia questa."
	]
	quest.11F3D55DB0663504.quest_subtitle: "Stwórz Controller - blok pośredniczący w przetwarzaniu energii wymaganej do działania sieci tworzącej twój magazyn."
	quest.120DA35C03EB2C7B.quest_subtitle: "Stwórz Precision Dispeller, który pozwala na selektywne usuwanie klątw i enchantów z twojego wyposażenia."
	quest.120DA35C03EB2C7B.title: "Selekcja nienaturalna"
	quest.12A6AE17D88B6DD7.quest_desc: ["&o&#18950220% szansy."]
	quest.12A6AE17D88B6DD7.quest_subtitle: "Przetrząśnij zgliszcza zniszczonej bramy po płonącej stronie świata."
	quest.12A6AE17D88B6DD7.title: "Gorączka każdej pory"
	quest.13564BB91763C721.quest_desc: ["&o&#189502Królem ciężko nazwać osobę, która satysfakcjonuje się byle karpiem czy szczupakiem. "]
	quest.13564BB91763C721.quest_subtitle: "Złów po jednym z najspospolitszych gatunków zamieszkujących rzeki (i jeziora)."
	quest.13564BB91763C721.title: "Książe rzek i jezior"
	quest.13CCE6DFA2C5A44E.quest_subtitle: "Czy latającą rybę wciąż można nazwać rybą? Złów po jednym z najspospolitszych gatunków występujących w Endzie."
	quest.13CCE6DFA2C5A44E.title: "Ekstrawagancja wśród pospolitości"
	quest.140DA3F66DCDF55D.quest_subtitle: "Pokonaj Chesed."
	quest.1450CFB3246F596A.quest_desc: ["&o&#18950230% szansy."]
	quest.1450CFB3246F596A.quest_subtitle: "Odszukaj i obróć w pył pudło dające życie potworom w mrokach jaskiń."
	quest.1450CFB3246F596A.title: "Szczepionka podziemi"
	quest.14EA1CF55176B03B.quest_subtitle: "Wypada z Withera."
	quest.15D5D004621EFE27.quest_desc: ["&o&#189502Skórzane buty oraz inne buty z efektem powolnego upadania nie niszczą upraw."]
	quest.15D5D004621EFE27.quest_subtitle: "Pomyślnie daj się oszukać na 10zł."
	quest.15D5D004621EFE27.title: "Pierwsze kroki"
	quest.16405CD46460EFD5.quest_subtitle: "Stwórz Timedoor Marker - odbiornik oraz Location Card(s) - karty przechowujące koordynaty."
	quest.16405CD46460EFD5.title: "Prototyp teleportera"
	quest.16A4ED2B1C6A897B.quest_desc: ["&o&#189502Możesz użyć go również w celu ulepszenia żelaznej zbroji, lub stworzyć narzędzia o wyższym zasięgu."]
	quest.16A4ED2B1C6A897B.quest_subtitle: "Stwórz Cognitive Alloy - podstawę w stworzeniu wielu przedmiotów @Cognition."
	quest.16A4ED2B1C6A897B.title: "Tego nie pomalujesz"
	quest.19CB176EF5985F56.quest_desc: ["&o&#189502Bądź konsekwentny, a twój Pan nauczy cię więcej (więcej informacji o tym i reszczie zawartości @Eidolon, znajdziesz w Ars Ecclesia)."]
	quest.19CB176EF5985F56.quest_subtitle: "Przygotuj swój prowizoryczny ołtarzyk niezbędny by twoje modły zostały wysłuchane."
	quest.19CB176EF5985F56.title: "Rate my setup 1-666"
	quest.1A0E9C23E2A9C001.quest_subtitle: "Oko pozostawione w skrzyniach ukrytych głęboko pod ziemią."
	quest.1A45643F859B60C7.quest_desc: ["&o&#189502A tak dokładniej, pozwalające im na teleportację w miejsce twojego położenia."]
	quest.1A45643F859B60C7.quest_subtitle: "Stwórz Location Broadcaster. Jest to urządzenie śledzące przesyłające dane odnośnie twojej lokalizacji innym graczom."
	quest.1A45643F859B60C7.title: "Drop the addy"
	quest.1A96EB7F70EF612A.quest_subtitle: "W drastyczny sposób wycofaj licencję Maledictusa na rzucanie uroków."
	quest.1A96EB7F70EF612A.title: "Egzorcyzm za pół ceny"
	quest.1ABA6AF8E49019CC.quest_desc: ["&o&#18950220% na występienie."]
	quest.1ABA6AF8E49019CC.quest_subtitle: "Przeszukaj zardzewiałe tory w głębi czerwonych kanionów i opróżnij porzucony wózek zawierający wzór Greed."
	quest.1ABA6AF8E49019CC.title: "Wieczna żądza"
	quest.1ACDA4B32156FFC5.quest_subtitle: "Stwórz Exo Leggings."
	quest.1BA677FD6B5B742E.quest_desc: ["&o&#189502Może warto byłoby przespać się nieopodal prastarej rzeźby niedługo po kontakcie z nią?"]
	quest.1BA677FD6B5B742E.quest_subtitle: "Odnajdź starożytne ruiny zagubione w czasie. "
	quest.1BA677FD6B5B742E.title: "Opowiem ci bajkę"
	quest.1BC9E2273E2C4117.quest_subtitle: "Użyj Centrifuge by zamienić kłębki siana w Biopolimer - później wsadź go z powrotem do maszyny by wydobyć Plastik."
	quest.1BC9E2273E2C4117.title: "Plastik do rzułtego"
	quest.1BF01B861A94F1BA.quest_desc: ["&o&#189502Używaj LShift/LCtrl by regulować łańcuch oraz spacji do wyskoku (w ustawieniach możesz dostosować bindy do własnego gustu)."]
	quest.1BF01B861A94F1BA.quest_subtitle: "Stwórz swój pierwszy Grappling Hook."
	quest.1BF01B861A94F1BA.title: "Podróże ze stylem"
	quest.1C70C216593C2059.quest_desc: ["&o&#189502Jest to mod opierający się na wzbogaceniu sposobów na zdobywanie xp oraz nadanie mu większej ilości zastosowań. Zawiera też bloki pomagające w automatyzacji mob grinderów oraz zintegrowany jest m.in. z modem dodającym smoki - daje możliwość stworzenia jaja."]
	quest.1C70C216593C2059.quest_subtitle: "Poniżej znajdziesz questy do moda @Cognition."
	quest.1C70C216593C2059.title: "Cognition"
	quest.1CB725E712AA63BC.quest_desc: ["&o&#189502Tyle zupy byłoby w stanie cały serwer wykarmić... "]
	quest.1CB725E712AA63BC.quest_subtitle: "Co robisz? Zostań koneserem zup."
	quest.1CB725E712AA63BC.title: "Krzysiu."
	quest.1D75BD8743A978B0.quest_desc: ["&o&#18950211,4% szansy."]
	quest.1D75BD8743A978B0.quest_subtitle: "Spędź noc u boku czworonożnego drapieżnika, oczekując na prezent."
	quest.1D75BD8743A978B0.title: "Kocia wdzięczność"
	quest.1DF62F6EFB6A3249.quest_desc: [
		"&o&#189502Podgląd domyślnie dostępny jest pod LAlt. Włożysz tam również większość broni i narzędzi z modów - nie tylko łopatę, czy siekierę."
		""
		"&o&e*Copper Tool Belt nie jest wymagany do ukończenia questa."
	]
	quest.1DF62F6EFB6A3249.quest_subtitle: "Stwórz tool belt by pozwolić sobie na swobodniejsze wybieranie tych narzędzi, które nie mieszczą się w pasku szybkiego dostępu."
	quest.1DF62F6EFB6A3249.title: "Budowlaniec"
	quest.1E2C55B10A608D2A.quest_subtitle: "Pokonaj Dark Doppelgangera. Przy okazji postaraj się nie popełnić samobójstwa."
	quest.1E2C55B10A608D2A.title: "spidermanmeme.jpg"
	quest.1E724059237A1536.quest_subtitle: "Stwórz Crafting Grid - interfejs z wbudowanym craftingiem."
	quest.1E8D6F4FD5008208.quest_subtitle: "Ogranicz dyspozycyjność grubego na straży. Pokonaj Ender Guardiana"
	quest.1E8D6F4FD5008208.title: "Nadgodziny w Endzie"
	quest.201524A08E3E1966.quest_desc: ["&o&6*piwo zachęca cię do dalszej rozgrywki*"]
	quest.201524A08E3E1966.quest_subtitle: "Zabij zajebiście przerażającego dementora, który potrafi zniknąć jak gdyby nigdy nic i pojawić z powrotem. Niesamowicie przerażające, nie wiem jak ty będziesz grać dalej na tym serwerze."
	quest.201524A08E3E1966.title: "Ghostbuster"
	quest.2020FA1868EA0796.quest_desc: ["&o&#18950250% na występienie."]
	quest.2020FA1868EA0796.quest_subtitle: "Odkryj tajne przejście w śnieżnej chatce i przejmij pilnowaną w piwnicy zawartość."
	quest.2020FA1868EA0796.title: "Arktyczne odkrycie"
	quest.20B1055C087D3636.quest_desc: ["&o&#189502Wszystkie zniszczone bloki będą przez niego pozyskane, co pozwoli ci na łatwiejsze zdobywanie surowców."]
	quest.20B1055C087D3636.quest_subtitle: "Stwórz Destroyer Block, używany w automatycznych farmach [roślin] oraz wykopywaniu masywnych dziur"
	quest.2142316B24C4EA52.quest_desc: ["&o&#189502@Oritech to mod, który pozwoli stworzyć wiele ciekawych maszyn. Niektóre przydadzą się w wydobyciu ponad dwukrotnie więcej surowców niż możliwe byłoby to w samym piecu, inne posłużą w automatycznej farmię, lub wykopią za ciebie wielką dziurę, kolejne przydadzą się w stworzeniu Jetpacka i wysoko zaawansowanych narzędzi oraz niektórych artefaktów."]
	quest.2142316B24C4EA52.quest_subtitle: "Zdobądź śladowe ilości minerałów z @Oritech."
	quest.2142316B24C4EA52.title: "Oritech"
	quest.22CBD6C479406B6F.quest_subtitle: "Stwórz Cybernetic Research Station - moduł wymagany do pierwszych modyfikacji w Cybernetic Augmentation Center."
	quest.22CBD6C479406B6F.title: "Bionicle 2"
	quest.232306814FE7BE31.quest_subtitle: "Daj się ponieść rozkoszy kulinarnej. Wyciągnij pizze z pieca odrobinę za późno."
	quest.232306814FE7BE31.title: "Niech bóg ci w dzieciach wynagrodzi"
	quest.239E2BF3F495E5B0.quest_subtitle: "Stwórz Memory Tablet by uzyskać dostęp do Obelisku niezależnie od dystansu, który was dzieli."
	quest.239E2BF3F495E5B0.title: "Synchronizacja świadomości"
	quest.23B0210D5ABBA511.quest_subtitle: "Stwórz Bibliophage - wirusy dewastujące wiedzę zapisaną w księgach, ekstraktujące doświadczenie z biblioteczek."
	quest.23B0210D5ABBA511.title: "Mol książkowy"
	quest.23BDFF01DB40E39E.quest_desc: ["&#189502&oTemperaturę regulują również podszycia ze zwykłej, krowiej skóry (uniwersalna), skóry królika (odpornośc na ciepło) oraz wełny (odporność na chłód)."]
	quest.23BDFF01DB40E39E.quest_subtitle: "Dostosuj termoprzewodność swojej zbroi. Futro kozy pomoże zachować ciepło - skóra hoglina cię schłodzi."
	quest.23BDFF01DB40E39E.title: "Maszyna do szycia"
	quest.23FDEFEBEB253702.quest_desc: ["&o&#189502Kolejnej mapy nie dostaniesz, bo i tak byś zbłądził"]
	quest.23FDEFEBEB253702.quest_subtitle: "Znajdź główną atrakcję paczki (trzy gieta jarania). A tu coś dla ciebie na gastro, wyśmienity przysmak"
	quest.23FDEFEBEB253702.title: "Polak w Amsterdamie"
	quest.24143DFFB2078D53.quest_subtitle: "Wyjdź ze swojej strefy komfortu i nieco poniżej poziomu morza; złów pojednym z najspospolitszych gatunków występujących w podziemiach."
	quest.24143DFFB2078D53.title: "Głębokie zaangażowanie"
	quest.24C709911FA83CE4.quest_desc: ["&o&#189502Niezdolny do poprawiania jakości (wydłużenia czasu lub zwiększenia mocy)"]
	quest.24C709911FA83CE4.quest_subtitle: "Stwórz Apothecary Stand, który postawiony na rozgrzanym kociołku nie wymaga żadnych dodatkowych zasobów by tworzyć mikstury."
	quest.24C709911FA83CE4.title: "Zestaw małego alchemika"
	quest.2504508DA0476C33.quest_subtitle: "Przebiegnij 25k oraz przejdź 5k bloków."
	quest.2504508DA0476C33.title: "Turysta"
	quest.2527BB941B9A0DC3.quest_subtitle: "Pokonaj Aeromancera, ucznia Fujina. Nie żeby ktoś pamiętał o jego istnieniu."
	quest.2527BB941B9A0DC3.title: "Ying-Yang-Yong?"
	quest.252D8D06FADD5D74.quest_subtitle: "Duże ulepszenie względem zwykłego Ender Chesta. Do stworzenia go potrzebne ci będzie jedndak zapoznanie się lepiej z kategorią &lTechnologii&r (questy). "
	quest.25762D0A2987CF14.quest_subtitle: "Stwórz jakikolwiek wariant kanapy. Młotek pozwala na przełączanie między wariantami niektórych bloków z tego moda."
	quest.25762D0A2987CF14.title: "Relaks 100%"
	quest.257B7B1DACBC55D6.quest_desc: ["&o&#189502Z pewnością czegoś strzegło to monstrum..."]
	quest.257B7B1DACBC55D6.quest_subtitle: "Namierz Netherithe Montrosity, po czym pokonaj go."
	quest.257B7B1DACBC55D6.title: "Złomowanie na wezwanie"
	quest.263308432915424B.quest_subtitle: "Pokonaj oddział szturmowy Pillagerów - Raider Blimp. Występuje jedynie na raidach piątego poziomu i potrafi atakować do 7 jednostek jedncześnie."
	quest.263308432915424B.title: "Led Zeppelin"
	quest.26725949E2759EB2.quest_subtitle: "Spróbuj wyłowić coś w Endzie."
	quest.26E495C90C5FD99F.quest_desc: ["&o&#189502Jest również niezbędny do zainstalowania modułów ulepszających sprawność Tempada, choć obecnie ogranicza się to do wgrania wiki i teleportacji do innych graczy."]
	quest.26E495C90C5FD99F.quest_subtitle: "Stwórz Workstation - pozwala na oszczędność i utrzymywanie otwartego portalu na znacznie dłuższy okres czasu (aktywowanego sygnałem redstone)."
	quest.26E495C90C5FD99F.title: "Bede grał w gre"
	quest.2733C886B23E63B6.quest_subtitle: "Zniszcz Raider Drill - jednostkę Pillagerów występującą na Raidach wywołanych Bad Omen drugiego poziomu. Po jego zniszczeniu możesz zdobyć różne ciekawe, zaklęte książki."
	quest.2733C886B23E63B6.title: "Krecik na sterydach"
	quest.2736CF55E89224A9.quest_subtitle: "Ta zbroja zapewni ci trochę ciepła lub chłodu, w zależności od potrzeb. Przydałoby jednak zająć się wreszcie hodowlą owiec i zajączków, bo nie starczy ci to na długo."
	quest.2736CF55E89224A9.title: "Danse macabre"
	quest.27A9460AD10ABCFE.quest_desc: ["&o&#189502Możesz przerobić go na mniejsze cząstki, dzięki czemu odnowisz trochę wytrzymałości kilku różnym przedmiotom."]
	quest.27A9460AD10ABCFE.quest_subtitle: "Stwórz Mending Neurogel, którym możesz jednorazowo naprawić uszkodzone przedmioty."
	quest.27A9460AD10ABCFE.title: "Kropelka"
	quest.2865A13DBA03B451.quest_subtitle: "Skarb ukryty głęboko w dżungli."
	quest.2900AC7D80AED731.quest_desc: ["&o&#189502Przypisz ją do konkretnego, oswojonego zwierzęcia klikając PPM "]
	quest.2900AC7D80AED731.quest_subtitle: "Stwórz muszlę, która pozwoli ci przyzywać swojego zwierzaka w dowolnym momencie."
	quest.2900AC7D80AED731.title: "Najpiękniejsza z wybrzeża"
	quest.296C5784181B3314.quest_desc: ["&o&#189502Wpisz \"&6*nazwa drewna*&o&#189502 door\" w wyszukiwarkę JEI, żeby zobaczyć jak je zrobić."]
	quest.296C5784181B3314.quest_subtitle: "Na serwerze istnieje kilka wariantów dostępnych dla niemal każdego rodzaju drewna (i niektórych metali). Stwórz dowolne z nich."
	quest.296C5784181B3314.title: "DOORSTUCK!!!"
	quest.29A5085E9B8C610A.quest_subtitle: "Ukryte na posesji pillagerów."
	quest.29ADD9F4CF2EF063.quest_subtitle: "Podstawa między innymi by uchronić się od przegrzania, lub trzeźwości. Zajeb wiadro (na raz)."
	quest.29ADD9F4CF2EF063.title: "Inżynieria plastikowej butelki"
	quest.29C54E3640CC64D4.quest_subtitle: "Zdobądź wszystkie kolory papryki. "
	quest.29C54E3640CC64D4.title: "Yy-yyyy y yyy-y yy-yyy, papryka"
	quest.2A89B955221DC4DE.quest_subtitle: "Stwórz Wayward Compass, który doprowadzi cię do Katakumb - miejsca pełnego lepszych spelli, mobów i całkiem ciężkiego bossa."
	quest.2AE937A6C222B0EE.quest_subtitle: "Stwórz Sawmill. Pomoże ci w ekonomicznym dysponowaniu drewnem (na wzór Stonecuttera/Przecinarki)"
	quest.2AE937A6C222B0EE.title: "Cięcie kosztów"
	quest.2B32DE45CB331EA1.quest_desc: ["&o&#189502Spider-Man z Tobym Maguire'em to najlepszy Spider-Man. "]
	quest.2B32DE45CB331EA1.quest_subtitle: "Upiecz swój pierwszy kawał ciasta z dodatkami."
	quest.2B32DE45CB331EA1.title: "It's Pizza Time!"
	quest.2B6A8DD4158FE7DC.quest_subtitle: "Stwórz Easel - sztalugę na której dużo nie pomalujesz, ale przynajmniej możesz użyć jej do wybrania konkretnego obrazu."
	quest.2B6A8DD4158FE7DC.title: "Dusza artysty"
	quest.2BA72A813B9BFA1D.quest_subtitle: "Napisz wierszyk."
	quest.2BA72A813B9BFA1D.title: "Atrament"
	quest.2BDF70A6B93C7281.quest_subtitle: "Wybij całą rodzinę królewską składającą się z [Royal]: Zombie, Skeleton, Creeper, Enderman"
	quest.2BDF70A6B93C7281.title: "Zamachowiec"
	quest.2CC10E69E4B0B3C9.quest_desc: ["&o&#189502Kiedyś przypałętał się pod moją chatą chłop od fotowoltaiki, ale zanim doszedł do drzwi, zmienił swój cel (zareklamowanie produktu) i powiedział, że w sumie nieważne i nawet nie spodziewał się, że ktoś go tu wpuści. Zaczął zachwalać ogród i prosić mnie, czy mógłby zrobić ze swoją kobietą, która również z nim była, zdjęcie przy jakiejś konkretnej roślinie pod moim domem. Pogadał od niechcenia minutę, czy dwie odnośnie firmy, którą reklamował, po czym jeszcze raz pochwalił ogród i podziękował za zdjęcie przy jakimś nieco podwiędłym kwiecie. True story"]
	quest.2CC10E69E4B0B3C9.quest_subtitle: "Stwórz Big Solar Panel."
	quest.2CC10E69E4B0B3C9.title: "Fotowoltaika"
	quest.2CC666CB36DAAC11.quest_subtitle: "Znalezione w igloo."
	quest.2D37D798B89327DA.quest_subtitle: "Stwórz Alchemist Cauldron. Posłuży ci w warzeniu mikstur, tworzeniu eliksirów, recyklowaniu zwojów i ulepszaniu klasy atramentu. "
	quest.2DA5A5F802796894.quest_subtitle: "Stwórz jakąkolwiek farbę, która pozwoli na większą dowolność estetyczną w twojej pracowni."
	quest.2DA5A5F802796894.title: "Paint the town red"
	quest.2DB69E2D151C9C65.quest_desc: ["&o&#189502Na start zalecany jest set Wandering Magician."]
	quest.2DB69E2D151C9C65.quest_subtitle: "Odziej dowolne szaty czarodzieja"
	quest.2ECC70C9AA13E98D.quest_desc: ["&o&#189502"]
	quest.2ECC70C9AA13E98D.quest_subtitle: "Stwórz Hand Drill, całkiem efektywny multitool. Nie zapomnij naładować go przed wejściem do kopalni."
	quest.2ECC70C9AA13E98D.title: "Śląsk: Przebudzenie"
	quest.2F84A136E3A41952.quest_subtitle: "Zabij 100 istot."
	quest.2F84A136E3A41952.title: "Łowca"
	quest.2F8F87AF16F842D3.quest_desc: ["&o&#189502Jego funkcjonalność nie ogranicza się jednak tylko do tego. Wszystkie zastosowania możesz sprawdzić dzięki JEI (kliknij U na przedmiot w ekwipunku)."]
	quest.2F8F87AF16F842D3.quest_subtitle: "Stwórz Pulverizer, czyli pierwszy przedmiot pomagający w wydobyciu nieco więcej z pozyskanych w kopalni złóż."
	quest.2F8F87AF16F842D3.title: "Wsadź tam palca. Albo kolegę"
	quest.3069A6559DA19DD0.quest_desc: ["&o&e*Portable Tank nie jest wymagany do ukończenia questa."]
	quest.3069A6559DA19DD0.quest_subtitle: "Stwórz Fluid Addon i podłącz go do Centifuge, co pozwoli ci na odblokowanie nowych możliwości tej maszyny."
	quest.309E5057E29D50CE.quest_subtitle: "Właśnie tyle wystarczy ci, by zyskać maksymalną zmiennocieplność możliwą do zaaplikowania na zbroji. Hoduj kameleona na tyle długo, by zliniał 23 razy... Lub zabij ich naprawdę dużo :["
	quest.309E5057E29D50CE.title: "Może być, ja się dostosuję."
	quest.30B4063F73F3AC7E.quest_subtitle: "Stwóz kalendarz, przydatny do poznania dokładnej pory roku."
	quest.30B4063F73F3AC7E.title: "Wake up, it's the 1st of the month!"
	quest.312127513B220DE2.quest_desc: ["&o&#189502@Iron'sSpells'nSpellbooks pozwoli ci na opanowanie wysokiej jakości zaklęć przydatnych między innymi w walce. Progresja w modzie została specjalnie utrudniona, by skupić się na nim dopiero w późniejszym stadium gry: zanim zaczniesz posługiwać się danym zaklęciem, musisz się go nauczyć, podobnie z poziomem (jakością) spelli."]
	quest.312127513B220DE2.quest_subtitle: "Zdobądź Arcane Essence - najistotniejszy zasób czarodziejów. Występuje w wielu strukturach oraz wypada z niektórych magicznych mobów."
	quest.31DEED558309B910.quest_subtitle: "Przebiegnij 100k bloków oraz przejdź 25k bloków."
	quest.31DEED558309B910.title: "Obieżyświat"
	quest.3317D41D582088CB.quest_desc: ["&o&e*wariant przeźroczysty jest opcjonalny."]
	quest.3317D41D582088CB.quest_subtitle: "Stwórz Opaque Item Pipe(s) - rury, które pozwolą ci na tranport przedmiotów."
	quest.3317D41D582088CB.title: "Licencjat z logistyki"
	quest.336A10C4F5EA06DF.quest_desc: ["&o&#189502Rich Soil przyśpiesza tempo rośnięcia roślin"]
	quest.336A10C4F5EA06DF.quest_subtitle: "Stwórz Organic Compost, który dzięki słońcu, wodzie i grzybom zamienić możesz w Rich Soil."
	quest.33AA200381E04D10.quest_desc: ["&o&#189502Sam z siebie nie zapewni ci żadnych korzyści. Przejdź do następnego questa."]
	quest.33AA200381E04D10.quest_subtitle: "Stwórz Cybernetic Augmentation Center, który pozwoli ci na permamentne modyfikacje biotechnologiczne w twojego ciała by ułatwić ci życie."
	quest.33AA200381E04D10.title: "Bionicle"
	quest.33B05EE963A8B3FA.quest_subtitle: "Poszukiwane przez wielu piratów. Zakopane wieki temu dla bezpieczeństwa świata."
	quest.3402F09E4FD5D890.quest_desc: [
		"&o&#189502Pamiętaj, że w JEI każdy item możesz dodać do \"polubionych\" klikając na niego A będac w GUI ekwipunku. Te przedmioty wyświetlają się wtedy po lewej stronie ekwipunku. Bardzo przyda ci się to w łatwiejszej nawigacji co chcesz zrobić i czego potrzebujesz."
		""
		"&o&e*wariant w ramce jest opcjonalny"
	]
	quest.3402F09E4FD5D890.quest_subtitle: "Stwórz Energy Pipe(s). Niezbędne w transportacji energii."
	quest.3402F09E4FD5D890.title: "Rura musi jebać"
	quest.34D8DFDF334BE1DB.quest_subtitle: "Rozmnóż zwierzęta po raz pierwszy."
	quest.34D8DFDF334BE1DB.title: "Dawca nasiana"
	quest.34E4D121FEF6CE02.quest_desc: ["&o&#189502Spróbuj włożyć sztabkę jakiegoś metalu do otrzymanej nagrody"]
	quest.34E4D121FEF6CE02.quest_subtitle: "Stwórz Framing Table - stół przeznaczony do personalizacji swoich Storage Drawers i dopasowania ich do wnętrz."
	quest.34E4D121FEF6CE02.title: "U siebie rób jak u siebie"
	quest.3519845412B69924.quest_desc: ["&#189502&oKowadła przeszły rework: używanie książek jest tańsze, koszta skalują się mniej dramatycznie, a zmiany nazw nametagów są bezpłatne. Blok żelaza może z kolei naprawić obecne uszkodzenia. Poza tym, możesz użyć ich do zgniatania niektórych przedmiotów (więcej info w JEI, kliknij U i zmień zakładkę)."]
	quest.3519845412B69924.quest_subtitle: "Stwórz kowadło o odświeżonym działaniu."
	quest.3519845412B69924.title: "Kowal swojego losu"
	quest.364F3CAB81187909.quest_subtitle: "Stwórz kociołek. Będziesz potrzebować źródła ciepła pod spodem by zagotować wodę; spróbuj ognia lub bloku magmy."
	quest.364F3CAB81187909.title: "Wprowadź seksistowski żart o gotowaniu"
	quest.37056DB5FD12F854.quest_desc: ["&o&#1895026,2% występowania."]
	quest.37056DB5FD12F854.quest_subtitle: "Zanurkuj w lodowatej głębi i wyczyść dno zatopionego królestwa by pozyskać wzór Horizon."
	quest.37056DB5FD12F854.title: "Podwodny archeolog"
	quest.370824701EA5123A.quest_desc: ["&o&#189502110% nie jest dosłownym mnożnikiem. Nie mam pojęcia jaki świadczy bonus."]
	quest.370824701EA5123A.quest_subtitle: "Stwórz Fortuitous Amulet, który pozwoli ci wydobyć 110% z każdej kulki expa."
	quest.370824701EA5123A.title: "Premia uznaniowa"
	quest.3787F87A8C11CBCA.quest_subtitle: "To chyba służy za automatyzację uruchamiania zamiennie Icebox/Boiler w zależności od temperatury. Ale za chuja jeszcze nie próbowałem zrozumieć tego bloku. Powodzenia!"
	quest.3787F87A8C11CBCA.title: "Poka roga"
	quest.37E163650FA68521.quest_subtitle: "Stwórz Enlightened Amulet, który pozwoli ci na efektywniejszą kradzież expa innym graczom."
	quest.37E163650FA68521.title: "Złodziej myśli"
	quest.389BD903837850E8.quest_desc: ["&o&#189502 Po ukończonej sesji kliknij \"U\" na kliszę w ekwipunku by zobaczyć co zrobić z nią dalej."]
	quest.389BD903837850E8.quest_subtitle: "Stwóz aparat, i czarno-białą kliszę, by móc dokumentować swoje wyprawy."
	quest.389BD903837850E8.title: "Chłopiec z wąsem"
	quest.38A3FBF81F8A8A92.quest_subtitle: "Zdobądź połowę wszystkich ryb występujących w dzienniku rybackim."
	quest.38A3FBF81F8A8A92.title: "Pół-profesjonalista"
	quest.38EF0BA4CEFCAA93.quest_desc: ["&o&#189502Wymaga uprzedniego naładowania (1500C) by zaczął działać."]
	quest.38EF0BA4CEFCAA93.quest_subtitle: "Stwórz Metronome - generator Chrononu, który możesz pozostawić w miejscu."
	quest.38EF0BA4CEFCAA93.title: "BANGARANG, BASS!"
	quest.3985D3BF836CAAB8.quest_desc: ["&o&#189502"]
	quest.3985D3BF836CAAB8.quest_subtitle: "Stwórz Bio Generator, który pozwoli ci na wydobywanie energii z innych przedmiotów niż dotychczas."
	quest.3985D3BF836CAAB8.title: "Zdelegalizować paliwo kopalne!"
	quest.3A24136C85987AEB.quest_desc: ["&o&#189502Możesz użyć go również do ulepszenia Enderic Laser."]
	quest.3A24136C85987AEB.quest_subtitle: "Stwórz Quarry Addon, który powiększy zasięg Destroyer Block."
	quest.3A4CE260ABCD9D50.quest_subtitle: "Stwórz Assembler. Posłuży ci w tworzeniu nowych przedmiotów, oraz paru niemożliwych do stworzenia przedmiotów ze zwykłego Minecrafta. "
	quest.3A4CE260ABCD9D50.title: "Początkowe mnożenie minerałów"
	quest.3CBBFA55D117EE1A.quest_desc: ["&o&#189502Zużywa 1KC przy każdym użyciu"]
	quest.3CBBFA55D117EE1A.quest_subtitle: "Stwórz Timedoor Projector - zasadniczo portal gun."
	quest.3CBBFA55D117EE1A.title: "Nagły skok technologiczny"
	quest.3CF0E5A0D608E81E.quest_desc: ["&o&#189502Przedmiot włożysz klikając PPM; wyjmesz go LPM. Kucając w trakcie możesz wyjąć cały stack. Dodatkowo możesz zabezpieczyć je kluczem przed tępym ludem, który nawet w grze nie potrafi nic osiągnąć samemu."]
	quest.3CF0E5A0D608E81E.quest_subtitle: "Na serwerze istnieje mnóstwo rodzajów skrzynek - stwórz jedną z nich. @StorageDrawers to z kolei mod który pomoże ci przechować ogrom bloków tego samego rodzaju. "
	quest.3CF0E5A0D608E81E.title: "Wzbogacenie kulturowe"
	quest.3D2FD350DA0589CB.quest_subtitle: "Stwórz syrop bezkodeinowy. :["
	quest.3D2FD350DA0589CB.title: "Sippin' on sum"
	quest.3E0F7DBC3682191C.quest_subtitle: "Zabij 10000 istot."
	quest.3E0F7DBC3682191C.title: "Tępiciel"
	quest.3F3862A47CCDC221.quest_desc: [
		"&#189502&oPodłącz do niego Smokestacki i poprowadź je po wszystkich pokojach w swoim domostwie - tak, by schłodzony dym wlatywał do środka. Postaw dźwignię obok bloku, by aktywować częściową ochronę przed przegrzaniem na określonym terenie. Zasilisz go chłodnymi przedmiotami."
		""
		"&o&e*Waterskin nie jest wymagany do ukończenia questa."
	]
	quest.3F3862A47CCDC221.quest_subtitle: "Stwórz Icebox, który posłuży jako chłodzenie domu- lub sakiewki, jeśli potrzebujesz schłodzić się w podróży."
	quest.3F3862A47CCDC221.title: "Cold-hearted killa"
	quest.3FC4BB445A10ADB7.quest_desc: ["&o&#189502Bardzo warto zaopatrzyć się w węgiel drzewny. Idąc wgłąb kopalni musisz przygotować się na zupełną ciemność, która bywa bezlitosna, jeśli nie przygotujesz pochodni."]
	quest.3FC4BB445A10ADB7.quest_subtitle: "Stwórz piec. Utrzymywanie go na chodzie ochroni cię przed wychłodzeniem. "
	quest.3FC4BB445A10ADB7.title: "Szafki i szuflady"
	quest.3FCBB86B8643A5E1.quest_subtitle: "Uczyń piramidę zaledwie obiektem turystycznym - poślij Ancient Remnanta do piachu."
	quest.3FCBB86B8643A5E1.title: "Praca u podstaw"
	quest.3FF0167BBF754C38.quest_subtitle: "Daj Ars Ecclessia księdzu (profesja wieśniaka) by pokazał ci drogę światła. Niezbędne do modlitw kierowanych do bóstw światła."
	quest.3FF0167BBF754C38.title: "Jeśli istniejesz, spraw żeby piorun we mnie pierdolnął i mnie zabił - liczę do trzech"
	quest.4262DAEB36955209.quest_subtitle: "Przygotuj talerz pełen wiśniowych pancakes."
	quest.4262DAEB36955209.title: "PinkPancakes"
	quest.432FC5619106E22B.quest_subtitle: "Pokonaj Ferrous Wroughtnaut - potwornie silnego i wytrzymałego, zapomniałego wojownika rezydującego pod ziemią - o wyłącznie jednym słabym punkcie."
	quest.432FC5619106E22B.title: "Topór w plecy"
	quest.43EBA7480A059BAD.quest_subtitle: "Stwórz Hunter Addon, który pozwoli Ci na zmienienie Enderic Laser w broń."
	quest.441D1B9E70ACFCBA.quest_subtitle: "Stwórz zbiornik na płyny o nieco większej pojemności od wiadra. Nie zaleca się wypełniania go moczem, ani piwem."
	quest.441D1B9E70ACFCBA.title: "Akwarium, ale industrialne"
	quest.4431458698DA3C44.quest_subtitle: "Zdobądź pierwszy, choć prawdopodobnie nie ostatni stack diamentów."
	quest.4431458698DA3C44.title: "[Zbiór otwarty]"
	quest.44540C8EE78F7735.quest_subtitle: "Stwórz Ender Chest."
	quest.44540C8EE78F7735.title: "Old Skool"
	quest.44BB69968A16EE38.quest_desc: [
		"&o&#189502Podłącz do niego Smokestacki i pociągnij ogrzewanie po wszystkich pokojach (dym musi wlatywać do zamkniętego pomieszczenia). Gdy już to zrobisz zapewnij maszynie dostęp do sygnału redstone (najlepiej dźwignią, by łatwo wyłączyć ogrzewanie na lato) Możesz w nim podgrzać również sakwę, by ogrzać się w trasie. Zasilisz go tym, co dobrze się pali, np. drewnem."
		""
		"&o&e*Waterskin nie jest wymagany do ukończenia questa."
	]
	quest.44BB69968A16EE38.quest_subtitle: "Stwórz Bojler, przydatny w ogrzewaniu pomieszczeń. "
	quest.44BB69968A16EE38.title: "Warm-blooded crack deala"
	quest.44DA921F925743EE.quest_desc: ["&#189502&o\"Przepisy\" na nie znajdziesz po kliknięciu na zieloną książkę w GUI."]
	quest.44DA921F925743EE.quest_subtitle: "Jeśli planujesz bawić się w strzelanie z łuku lub kuszy, nie zapomnij by zrobić sobie trochę ciekawszych strzał."
	quest.44DA921F925743EE.title: "Blok bezużyteczny, przynajmniej bez modów."
	quest.45602C94E54EBF57.quest_desc: ["&o&#189502Unfinished Manuscript pozwala ci na nauczenie się losowego spella z 40-procentową skutecznością"]
	quest.45602C94E54EBF57.quest_subtitle: "Stwórz Inscription Table - stół używany w przypisywaniu zaklęć do książki."
	quest.4689D2DE28D903BA.quest_subtitle: "Zabij Umvuthi - przywódcę plemienia Abavuthana, posiadacza mocy słońca."
	quest.4689D2DE28D903BA.title: "Przewdczesny zachód"
	quest.46DBB9C1E756FBD9.quest_desc: ["&o&#189502Nakierowując na przedmiot z Oritech w swoim ekwipunku i przytrzymaj LAlt by poczytać o nim więcej i zrozumieć jego zastosowania."]
	quest.46DBB9C1E756FBD9.quest_subtitle: "Stwórz swój pierwszy, najprostszy generator energii wymaganej w każdej maszynie z @Oritech. Zasilisz go dowolnym źródłem energii, które możesz wsadzić również do pieca."
	quest.46DBB9C1E756FBD9.title: "Elektryka bieda tyka"
	quest.472B81C725D5CEDD.quest_desc: ["&o&#189502Postaw garnek na kuchence, by dać mu źródło ciepła. "]
	quest.472B81C725D5CEDD.quest_subtitle: "Zacznij swoją przygodę z @FarmersDelight."
	quest.472B81C725D5CEDD.title: "We need to cook"
	quest.486A125E299D3251.quest_desc: ["&o&#189502Dodatek, który po użyciu we Fragment Forge zapewni ci podwójną ilość produktów ubocznych (które odziwo potrafią być coś warte)."]
	quest.486A125E299D3251.quest_subtitle: "Stwórz Yield Addon."
	quest.48C8DD6156858ADE.quest_desc: ["&o&#189502Uniwersalny dodatek pozwalający maszynie na efektywniejsze dysponowanie energią"]
	quest.48C8DD6156858ADE.quest_subtitle: "Stwórz Effieciency Addon, roztropniejszego brata Speed Addona."
	quest.48C8DD6156858ADE.title: "IShowEffieciency"
	quest.48D0125C2EAB00C3.quest_subtitle: "Nierozłączna część (ciała) Evokera."
	quest.49BF5B7EC7E978D2.quest_desc: ["&o&e*Exo Jetpack jest opcjonalnym ulepszeniem do Exo Chestplate; niewymagany do ukończenia questa."]
	quest.49BF5B7EC7E978D2.quest_subtitle: "Stwórz Exo Chestplate."
	quest.4A25CD937C5508E8.quest_subtitle: "Stwórz Experience Fountain i podłącz je do Experience Obelisk by móc wyrzucać expa w określonym tempie."
	quest.4A25CD937C5508E8.title: "Gejzer doświadczenia"
	quest.4ACB457A850274DA.quest_subtitle: "Zlokalizuj Harbringera i rozłóż go na części pierwsze."
	quest.4ACB457A850274DA.title: "Terminator z Radomia"
	quest.4B334DC15495994A.quest_subtitle: "Posiądź Literacką Nagrodę Nobla."
	quest.4B334DC15495994A.title: "Epicki atrament"
	quest.4BD0EE3DDADDCB7F.quest_subtitle: "Zainteresuj się literaturą; zacznij odróżniać prozę od poezji."
	quest.4BD0EE3DDADDCB7F.title: "Atrament, ale zielony"
	quest.4BF5C23F58C048B7.quest_subtitle: "Zabij 1000 istot."
	quest.4BF5C23F58C048B7.title: "Żniwiarz"
	quest.4CF2229AA14E2957.quest_subtitle: "Niezbędny do wyrobienia ciasta do pizzy. Połóż je na stole i rozciągnij za pomocą swojego nowego przyjaciela."
	quest.4CF2229AA14E2957.title: "Wał nad wałami"
	quest.4CFE18BB22FDEDDC.quest_desc: ["&o&#189502Ten przerośnięty powerbank może przydać się w dostarczaniu energii do maszyny z następnego questa."]
	quest.4CFE18BB22FDEDDC.quest_subtitle: "Stwórz Portable Energy Storage, czyli przenośny klocek z prądem."
	quest.4CFE18BB22FDEDDC.title: "Powerbank (bez Magsafe'a)"
	quest.4D7F48748DDCFD93.quest_subtitle: "To nie problem, jedynie cecha twojej osobowości. Wypij każdy rodzaj napoju z moda @BrewinNChewin"
	quest.4D7F48748DDCFD93.title: "Upokarzający alkoholizm"
	quest.4E5F7C9C06D492FB.quest_subtitle: "Starożytne oko zmumifikowane razem z jego właścicielem."
	quest.4F13C5A552B40785.quest_desc: ["&o&#18950250% śpiących graczy wystarczy do pominięcia nocy."]
	quest.4F13C5A552B40785.quest_subtitle: "It's time for school."
	quest.4F13C5A552B40785.title: "Wakey, wakey"
	quest.4F14986C8139C792.quest_desc: ["&o&#189502Znajdziesz w nich sloty odpowiające za filter dokładnie tego, co chcesz przenosić między zbiornikami."]
	quest.4F14986C8139C792.quest_subtitle: "Importer posłuży ci do ekstrakcji przedmiotów z beczek lub skrzynek  bezpośrednio do twojej sieci maszyn. Exporter przy się z kolei, jeśli chcesz przenieść konkretne przedmioty do zewnętrznych magazynów"
	quest.4F6FC1D5B9FDA73A.quest_desc: ["&o&#18950220% szansy."]
	quest.4F6FC1D5B9FDA73A.quest_subtitle: "Doprowadź do spięcia w Kresie i pozwól Endermanowi osobiście zmiażdżyć fioletowego intruza by zebrać to, co z niego zostanie."
	quest.4F6FC1D5B9FDA73A.title: "Konflikt interesów"
	quest.4FD0830D5C806DCA.quest_subtitle: "Pokonaj Archeovekera, generycznego skurwysyna, mieszankę wszystkiego co złe i brzydkie"
	quest.4FD0830D5C806DCA.title: "Fajnie było mieć zęby?"
	quest.4FFDD32FFA406623.quest_subtitle: "Spróbuj swoich umiejętności w tworzeniu swoich prawie autorskich pluszaków. "
	quest.50525FE6067D5D4C.quest_desc: ["&#189502&oSakiewkę możesz wylać na siebie (PPM), bądź wypić (LCTRL+PPM), jednak wypadałoby ją wpierw schłodzić lub podgrzać. "]
	quest.50525FE6067D5D4C.quest_subtitle: "Waterskin to przedmiot pomagający w regulacji temperatury."
	quest.50525FE6067D5D4C.title: "Sakiewką potrząśnij"
	quest.50998EEA5B0B397F.quest_subtitle: "Co to, kurwa, za tytuł?"
	quest.50998EEA5B0B397F.title: "Szanty i enchanty"
	quest.51E74BD1E182F672.quest_subtitle: "Pokonaj Malkuth."
	quest.51F37EC434AC3674.quest_desc: ["&o&#189502Może dałoby się ją jakoś zautomatyzować by nigdy więcej nie martwić się już o miejsce w ekwipunku?"]
	quest.51F37EC434AC3674.quest_subtitle: "Stwórz przenośna wersję ulepszonego Ender Chesta."
	quest.52C9BBFA039EA60D.quest_subtitle: "Opanuj poezję do istnej perfekcji."
	quest.52C9BBFA039EA60D.title: "Atrament, ale niezłej jakości"
	quest.52D938237AF8AF06.quest_subtitle: "Pokonaj Zapper. Potężnego Pillagera władającego prądem dzięki swojej różdżce. Występuje jedynie na raidach wywołanych Bad Omen czwartego poziomu."
	quest.52D938237AF8AF06.title: "Spalone bezpieczniki"
	quest.5313E8A7DAC9E4FD.quest_subtitle: "Oko możliwe do scraftowania z rzadszego lootu z wiedźmy."
	quest.5347948EE69342CD.quest_subtitle: "Stwórz Straw Bed - łóżko polowe, które nie zmienia twojego spawnpointa, pozwalając na spanie w trakcie podróży."
	quest.5347948EE69342CD.title: "Słowo harcerza"
	quest.53A10D8DBED3CC2B.quest_desc: ["&o&#18950233,3% szansy."]
	quest.53A10D8DBED3CC2B.quest_subtitle: "Zaufaj prehistorycznemu instynktowi i pozwól wielkiemu stworzeniu przekopać mchy prastarej tajgi w celu odnalezienia wzoru Origin."
	quest.53A10D8DBED3CC2B.title: "Pierwotny instynkt"
	quest.53B9837CC95B22FD.quest_desc: ["&o&#189502Gwarantowany drop."]
	quest.53B9837CC95B22FD.quest_subtitle: "Przyzwij i zgładź trójgłowy koszmar tam, gdzie błękitny płomień trawi piasek dusz."
	quest.53B9837CC95B22FD.title: "Powrót do korzeni"
	quest.5444B86854668BFC.quest_desc: ["&o&#189502Na pasek możesz założyć większość istniejących lamp, również te z modów"]
	quest.5444B86854668BFC.quest_subtitle: "Wyposaż się w lampę, którą możesz założyć na pasek aby oświetlała twoje otoczenie, zachowując miejsce w drugiej dłoni na tarczę."
	quest.5444B86854668BFC.title: "Jak skurwesyn"
	quest.544C17D7BBCB8FF6.quest_subtitle: "Do kupienia od villagerów o profesji Cleric (duchowny?) na najwyższym poziomie."
	quest.549A4EB0DBBE3B93.quest_subtitle: "Rozmnóż 666 zwierząt."
	quest.549A4EB0DBBE3B93.title: "Kultysta"
	quest.559DF73BEA1052C1.quest_desc: ["&o&#189502Zwiększa ilość przetrzymywanej energii i usprawnia jej przesyłanie."]
	quest.559DF73BEA1052C1.quest_subtitle: "Stwórz Capacitor Addon"
	quest.560D2F1F42CC9584.quest_subtitle: "Odkryj kolejne tereny zamieszkałe przez ryby; zwiedź Nether."
	quest.560D2F1F42CC9584.title: "It's Dark and Hell Is Hot"
	quest.564A0F00DA83D1EB.quest_subtitle: "Stwórz Safety Net, blok redukujący obrażenia od upadku."
	quest.564A0F00DA83D1EB.title: "Pułapka na samobójców"
	quest.57212D5E94254E36.quest_desc: ["&o&#189502Niezbędne również do przypisywania zaklęć do broni."]
	quest.57212D5E94254E36.quest_subtitle: "Stwórz Arcane Anvil, kowadło używane do ulepszania zwojów i wyposażenia"
	quest.57A20F96E843D804.quest_subtitle: "Pokonaj 6000 kratek na swoim (lub kradzionym) koniu."
	quest.57A20F96E843D804.title: "Koń z Valony"
	quest.590DF710FACB4CF0.quest_desc: ["&#189502&o"]
	quest.590DF710FACB4CF0.quest_subtitle: "Stwórz Stonecutter. @BuildingGadgets2 to mod, który pomoże ci na znacznie prostsze i mniej czasochłonne budowanie. Pamiętaj o nim gdy będziesz miał już wystarczająco materiałów budowlanych i ambitne plany, jeśli chcesz zaoszczędzić sobie trochę czasu."
	quest.590DF710FACB4CF0.title: "Rękoma byś tego nie ukruszył"
	quest.593C46813BCDF99E.quest_desc: ["&o&e*Wireless Crafting Grid jest opcjonalny."]
	quest.593C46813BCDF99E.quest_subtitle: "Stwórz Wireless Grid, który pozwoli ci na dostęp do swojego magazynu z odległości. Będziesz potrzebować również transmiterów, które musisz umieścić na dowolnym bloku należącego do sieci twojego magazynu. "
	quest.593C46813BCDF99E.title: "iPad"
	quest.5973DAA8CBAE5544.quest_subtitle: "Rozmnóż 20 zwierząt."
	quest.5973DAA8CBAE5544.title: "Opiekun"
	quest.59ACDC35EE4426CB.quest_desc: ["&o&#189502Niebieski odpowiednik zapewni chłód zamiast ciepła. Swoją drogą, pamiętaj, że możesz zasugerować mi dodatkowe bloki do puli, jeśli uważasz, że powinny stanowić źródło ciepła (również te z innych modów). Bardzo docenię wszelki feedback."]
	quest.59ACDC35EE4426CB.quest_subtitle: "Rozpal ognisko. Świetna sprawa, jeśli wolałbyś posiedzieć do późna na dworze."
	quest.59ACDC35EE4426CB.title: "Opowieści przy ognisku"
	quest.5A4C9A4F1F1A0749.quest_desc: ["&o&#189502Kwarc to fundamentalny składnik potrzebny do stworzenia nowoczesnego magazynu, który jest w stanie pomieścić niemalże nieskończone ilości przedmiotów i płynów oraz importować je ze skrzynek (np. z automatycznych farm)."]
	quest.5A4C9A4F1F1A0749.quest_subtitle: "Zdobądź kwarc."
	quest.5A4C9A4F1F1A0749.title: "Przegiołem, co?"
	quest.5AC30AE42523E178.quest_desc: ["&o&#189502"]
	quest.5AC30AE42523E178.quest_subtitle: "Stwórz Jetpack. Wkońcu zdobyłeś coś, po czym na pierwszy rzut oka widać użyteczność. Problemem jest tylko to, że nie działa. Przyjmij więc prezent, który pomoże ci rzeczywiście spożytkować swoją nową zabawkę."
	quest.5AC30AE42523E178.title: "Poczuj się jak Osioł w Shreku"
	quest.5AEB27B37E166F48.quest_desc: ["&e&o*dwie ostatnie są opcjonalne&r"]
	quest.5AEB27B37E166F48.quest_subtitle: "Skosztuj każdego wariantu pizzy."
	quest.5AEB27B37E166F48.title: "Gruby"
	quest.5C42E188AA148845.quest_subtitle: "Spróbuj wyłowić coś w Netherze."
	quest.5D21CF155DE766B9.quest_desc: ["&o&#1895021/3 skarbów."]
	quest.5D21CF155DE766B9.quest_subtitle: "Spędź burzową noc z wędką w ręku, licząc na łut szczęścia by pozyskać wzór Storm."
	quest.5D21CF155DE766B9.title: "Łowy podczas sztormu"
	quest.5D9DC9ED0EE1AB7C.quest_desc: ["&o&#189502Jeszcze tylko 39, by wrócić do domu."]
	quest.5D9DC9ED0EE1AB7C.quest_subtitle: "Wyłów okruszek obsydianu."
	quest.5E645B9B6BFB735B.quest_subtitle: "Pokonaj Echo of Tyros, władcę płomieni i ostatecznego bossa z moda Iron's Spellbooks (poza ekstremalnym wersjami Crucible poszczególnych bossów.)"
	quest.5E645B9B6BFB735B.title: "Sezon na grilla uważam za otwarty"
	quest.5EAFC2A9A5F9FBA0.quest_subtitle: "@Tempad to technologiczny mod, który wymaga chwili by dobrze go zrozumieć, jednak nagradza cię możliwością teleportacji - również do graczy. Najciekawsze wynalazki będą wymagać od ciebie posiadania netherite'u."
	quest.5EAFC2A9A5F9FBA0.title: "Tempad"
	quest.5ECA8149D538F204.quest_subtitle: "Opatentuj Time Steel, który pozwoli ci na ulepszenie swoich maszyn"
	quest.5ECA8149D538F204.title: "Kawał czasu"
	quest.600AD7CA814F0CCF.quest_desc: [
		"&o&#189502Do wyboru specjalizacje w (po kolei): &r&#FFC629szturmowaniu&o&#189502;"
		"&#62C5DBkłusownictwie&o&#189502;"
		"&#CE65D7łucznictwie&o&#189502;"
		"&#4B22E1kuszownictwie &o&#189502(łucznictwie&o&#189502, ale kuszą);"
		"&#E95802magii ognia&o&#189502;"
		"&#7EEBFFmagii lodu&o&#189502;"
		"&#99CF02magii trucizny"
		"&o&#189502lub &r&#940000magii krwi&o&#189502."
	]
	quest.600AD7CA814F0CCF.quest_subtitle: "Przed tobą ważna decyzja. Wybierz broń najlepiej odpowiadającą twoim preferencjom."
	quest.600AD7CA814F0CCF.title: "Opuścić Śląsk"
	quest.60293CEB5D84C982.quest_subtitle: "Pokonaj Frostmaw - przerośniętą i nieco mniej małpią wersję Yeti, z założenia przesypiającą całe swoje życie."
	quest.60293CEB5D84C982.title: "Będzie z ciebie ciepłe futro"
	quest.603D04D3E0DFFE39.quest_subtitle: "Rozgoń chmury wiszące nad Akropolią - odbierz koronę Scylli."
	quest.603D04D3E0DFFE39.title: "Cisza po burzy"
	quest.60C42139C4A697F3.quest_subtitle: "Stwórz termometr, niezbędny do poznania dokładnej temperatury ciała."
	quest.60C42139C4A697F3.title: "Thermomix"
	quest.60D12DD54AE8BD45.quest_subtitle: "Stwórz Experience Obelisk - blok służący do przechowywania twojego expa."
	quest.60D12DD54AE8BD45.title: "Skarbiec wiedzy"
	quest.611F7F824BEB4F94.quest_subtitle: "Postaw ciepły lub zimny blok w pobliżu baryłki co pozwoli ci na tworzenie konkretnych trunków."
	quest.611F7F824BEB4F94.title: "Alchemik brawury. Władca temperatury"
	quest.6136A5CA512FD5CC.quest_subtitle: "Pokonaj Geburah."
	quest.615374D9E2DB7AA6.quest_subtitle: "Stwórz stół w celu pierwszych modyfikacji wędki."
	quest.615374D9E2DB7AA6.title: "DIY"
	quest.617DBFB63EE03714.quest_desc: ["&o&e*ostatnie 4 pozycje są opcjonalne."]
	quest.617DBFB63EE03714.quest_subtitle: "Stwórz wszystkie rodzaje pancakes."
	quest.617DBFB63EE03714.title: "Baking pancakes"
	quest.61F56C49E7B974AA.quest_desc: ["&o&#189502Przed stworzeniem konkretnego zwoju będziesz musiał go odkryć. Weź to pod uwagę, że nie każdy spell istnieje w każdej klasie atramentu (niektóre zaczynają się od Uncommon, inne nawet od Rare lub Epic)."]
	quest.61F56C49E7B974AA.quest_subtitle: "Stwórz Scroll Forge - stół przeznaczony do tworzenia zwojów z pomocą atramentu, papieru i katalizatora (np. trujący ziemniak dla magii trucizny)."
	quest.637613BCD33D1CC7.quest_desc: ["&o&#189502Choć na razie zbędna, warto pamiętać o tej maszynie na przyszłość - gdy znajdzie się potrzebne usprawnienia pracy poszczególnych rur."]
	quest.637613BCD33D1CC7.quest_subtitle: "Stwórz Pipe Booster."
	quest.637613BCD33D1CC7.title: "Najszybsza rura w fabryce"
	quest.6377B3C19B2B1B35.quest_subtitle: "Opracuj tytułowy Tempad - urządzenie umożliwiające teleportację niezależnie od tego gdzie obecnie się znajdujesz."
	quest.6377B3C19B2B1B35.title: "Kontroler przestrzeni"
	quest.6382BA636DD1BD06.quest_desc: ["&o&#189502Pelagra i Beriberi to dwie spośród wielu chorób wynikających z braku edukacji na temat witamin i zbilansowanej diety. Nadmiar poszczególnych składników odżywczych, lub niedobór innych, powodował plagi demencji, paraliży kończyn, problemów rozwojowych, a czasem śmierci, za które często obwiniano okolicznych \"grzeszników\", uznając cierpienie za karę boską."]
	quest.6382BA636DD1BD06.quest_subtitle: "Popełnij wielki błąd i rozpocznij osiadły tryb życia - zacznij swoją przygodę z rolnictwem."
	quest.6382BA636DD1BD06.title: "Agrokultura i jej konsekwencje"
	quest.640A218299487892.quest_subtitle: "Wypłyń na głębsze wody; złów po jednym z najspospolitszych gatunków zamieszkujących oceany."
	quest.640A218299487892.title: "Czas szantów"
	quest.6433F66445D83342.quest_desc: ["&o&#189502Zalecane sposoby na zabezpieczenie się przez piekielnym upałem są: insulacja zbroji króliczą skórą oraz używanie bukłaków ze schłodzoną wodą, lub wypicie mikstury odporności na ogień (albo zjedzenia czegoś co również ją zapewnia). Najoptymalniejszym sposobem jest jednak stworzenie Soulspring Lamp widocznej w następnym queście."]
	quest.6433F66445D83342.quest_subtitle: "Odwiedź ciepłe kraje. Nether otwiera ci drzwi do odkrycia zawartości wielu modów, jednak pamiętaj, że zasrany mod na temperaturę nie pozwoli ci się tam rozgościć, jeśli nie przyjdziesz przygotowany."
	quest.6433F66445D83342.title: "It's Dark and Hell Is Hot"
	quest.6678DBE15F8C02EB.quest_subtitle: "Uniezależnij się od tego przeklętego państwa i podatków. Stwórz swoją własną baryłkę"
	quest.6678DBE15F8C02EB.title: "Twój stary"
	quest.67AD68BDB05061F5.quest_subtitle: "Możliwe, że stworzyłeś niedawno temu Jetpack i upadek okazał się zaskakująco bolesny. Stwórz Exo Boots w celu kompletnej negacji obrażeń od upadku."
	quest.67AD68BDB05061F5.title: "Sit back, relax, and enjoy the flight."
	quest.6815272EB26BE3E6.quest_subtitle: "Stacjonarna wieża z prądem. Na chuj komu tak wielki powerbank?"
	quest.681F1920FCE7F4E6.quest_subtitle: "Stwórz Nature's Compass, który doprowadzi cię na każdy ląd (lub ocean) znany człowiekowi."
	quest.681F1920FCE7F4E6.title: "Znany szlak"
	quest.685EDD2EB331636D.quest_subtitle: "Otwórz drzwi do ogromu nowych przedmiotów o magicznych właściwościach. Stwórz Magic Workbench."
	quest.685EDD2EB331636D.title: "Witchcraft"
	quest.68C6117611E0F38A.quest_subtitle: "Undead soul pozyskasz z zabicia konia-szkieleta."
	quest.6C8C697E9EB69E67.quest_subtitle: "Właściwie nie jestem pewien czy można to nazwać zwycięstwem. To nic nie dało i tak, nie dało nic. Pokonaj Dead Kinga."
	quest.6C8C697E9EB69E67.title: "To nic nie dało"
	quest.6D34F65A60159E70.quest_subtitle: "Stwórz Cinderous Soulcaller, artefakt zdolny do przebudzenia Echa Cytadeli."
	quest.6D9B2ACFAFEEEF5F.quest_desc: ["&o&e*Linear Accelerator jest opcjonalną alternatywą. Echo Chest przydaje się do łatwiejszego transportu rzeczy i expa z podłogi; obydwa niewymagane do ukończenia questu"]
	quest.6D9B2ACFAFEEEF5F.quest_subtitle: "Stwórz Accelerator, przydatny w transporcie lub tworzeniu efektywniejszych mob grinderów."
	quest.6D9B2ACFAFEEEF5F.title: "Szybcy i zdechli"
	quest.6E3560374E3949B4.quest_subtitle: "Stwórz Molecular Metamorhper - kluczową maszynę z @Cognition, która pozwoli ci na metamorfozę poszczególnych bloków, stworzenie przeróżnych Artefaktów, jaja smoka i paru innych rzeczy."
	quest.6E3560374E3949B4.title: "Metamorfizator-inator"
	quest.6E570C9841EAC9B4.quest_subtitle: "Stwórz bardziej zaawansowany aparat, który oszczędzi ci czasu straconego na wywoływaniu zdjęć."
	quest.6E570C9841EAC9B4.title: "Mężczyzna z zarostem"
	quest.6EA0A236CB6024EB.quest_desc: ["&o&#189502Posłużyć może ci również w podwajaniu swoich minerałów, pod warunkiem, że jesteś w stanie zaoferować trochę lawy. I czasu, by wszystko to efektywnie skoordynować."]
	quest.6EA0A236CB6024EB.quest_subtitle: "Stwórz Refinery, które za niewielki koszt pomoże ci zdobyć Silikon do stworzenia butów niezmiernie ważnych przy używaniu Jetpacka."
	quest.6EF773F252650299.quest_subtitle: "Zdobądź wszystkie wzory."
	quest.6EF773F252650299.title: "Pasja/Obsesja"
	quest.6F18530035AFF368.quest_subtitle: "Disk Drive to kolejny obowiązkowy komponent twojego zmodernizowanego magazynu. Podłącz go kablami do Controllera i przejdź do kolejnego questa."
	quest.6F6F9A60266A1B7C.quest_desc: ["&o&#189502Przygotuj ciepły kubraczek zanim wyruszysz wgłąb Endu."]
	quest.6F6F9A60266A1B7C.quest_subtitle: "End nie jest już tak łatwo dostępy. By pokonać smoka, cały serwer musi zmobilizować się najpierw by znaleźć 16 nowych rodzajów smoczych oczu. Dopiero wtedy otworzy się możliwość na zdobycie elytry i zwiady tego, co odnowiony End ma do zaoferowania."
	quest.6F6F9A60266A1B7C.title: "Koniec nie jest bliski"
	quest.702A81C31FAE8689.quest_subtitle: "Przeżyj 2 tygodnie bez śmierci. (in-game)"
	quest.702A81C31FAE8689.title: "Przetrwaniec"
	quest.7060778F63122957.quest_subtitle: "Przeżyj 3 dni bez śmierci. (in-game)"
	quest.7060778F63122957.title: "Ocalały"
	quest.717C4DA37D49B617.quest_desc: ["&o&#189502Poza tym można nimi rzucać. Może by tak rzucić w niewinnego kolegę i zobaczyć co się stanie?"]
	quest.717C4DA37D49B617.quest_subtitle: "Stwóż jakikolwiek nóż (na start nada się krzemienny lub żelazny). Szczególnie przydatne w wydobywaniu nowych zasobów ze zwierząt."
	quest.717C4DA37D49B617.title: "Potnę się, kurwy"
	quest.71BF4880B072069E.quest_subtitle: "Dokonaj 80 transakcji."
	quest.71BF4880B072069E.title: "Przedsiębiorca"
	quest.723B79879D294BF5.quest_subtitle: "Stwórz patelnię - domową wersję ogniska, która potrzebuje grzania od spodu do działania, a przy okazji broń"
	quest.723B79879D294BF5.title: "Teflon?"
	quest.739B4C7994D0E37F.quest_subtitle: "Możliwe do scraftowania."
	quest.749DEDF204BCA629.quest_desc: ["&o&#189502Jeden z pospolitszych dodatków do maszyn. Zapewnia dodatkową szybkość działania (kosztem większego zużycia energii)."]
	quest.749DEDF204BCA629.quest_subtitle: "My name is Bory Olo, I'm the fastest addon alive. Stwórz Speed Addon."
	quest.749DEDF204BCA629.title: "Industrialnamfetamina"
	quest.74B0F601DEE626C5.quest_subtitle: "Przebiegnij 5k oraz przejdź 1k bloków."
	quest.74B0F601DEE626C5.title: "Włóczęga"
	quest.752E8BD2AE542765.quest_subtitle: "Pokonaj Cryomancera i Pyromancera - frajerskich odpowiedników Sub-Zero i Scorpiona."
	quest.752E8BD2AE542765.title: "Złamanie Ying Yang"
	quest.7575FA5C40FFEA4C.quest_desc: ["&o&#189502Perły możesz użyć po uprzednim wyczyszczeniu portalu z pnączy. Dalszą zawartość tego moda odkryć będziesz musiał jednak sam"]
	quest.7575FA5C40FFEA4C.quest_subtitle: "Pokonaj strażnika by zdobyć dostęp do nowego wymiaru."
	quest.7575FA5C40FFEA4C.title: "Eternal Starlight"
	quest.767EF1C85B362FA2.quest_subtitle: "Spraw, by otchłań stała się bezpiecznym kąpieliskiem poprzez posłanie Leviathana na samo dno."
	quest.767EF1C85B362FA2.title: "Gruba ryba"
	quest.781C4466C0A3E473.quest_subtitle: "Wydobądź Ice Spider Egg. Nie wydaje mi się byś miał z niego większy pożytek niż ukończenie questa... Brawo!"
	quest.785F73E60461C450.quest_desc: ["&#189502&oHearth wymaga sygnału redstone'z dwóch stron by działać. Wrzuć do środka źródło ciepła (lawa, węgiel) lub chłodu (woda, śnieg) by zyskać odporność na dany efekt. Pamiętaj, by rozprowadzić rury po całym domu - Smokestack to nie komin, to bardziej coś w rodzaju archaicznej klimatyzacji (xD)."]
	quest.785F73E60461C450.quest_subtitle: "Od teraz możesz czuć się zupełnie swobodnie w swoim domu. Stwórz Hearth, który zapewni ci nietykalność termiczną w określonych pomieszczeniach."
	quest.785F73E60461C450.title: "Kotłownia"
	quest.78D55DF1BE9AEEDA.quest_subtitle: "@Handcrafted to mod dodający meble o różnych wariacjach. Zacznij od stworzenia nieco ciekawszego łóżka, w którym możesz dostosować pościel do swoich osobistych preferencji."
	quest.78D55DF1BE9AEEDA.title: "Jak sobie pościelisz"
	quest.78E43E34C6797CE7.quest_subtitle: "Stwórz portfel na swoje karty z przypisanymi do konkretnych lokacji."
	quest.78E43E34C6797CE7.title: "Pełne kieszenie"
	quest.798A5BA81E14A9B1.quest_subtitle: "Jesteś już prawie gotowy. Stwórz Flux Gate, ostatni składnik wymagany do maszyny, która zadba o zwiększenie efektywności twoich wizyt w kopalni."
	quest.798A5BA81E14A9B1.title: "Fluxin'"
	quest.79DC8F3C45AFB7CD.quest_desc: ["&o&#189502Dalsze questy pozwolą ci nauczyć się jak eksportować zawartość skrzynek na dysk (i vice versa), zablokować dostęp innym graczom oraz uzyskać dostęp do magazynu na odległość. "]
	quest.79DC8F3C45AFB7CD.quest_subtitle: "Stwórz Grid - jest to ostatni już blok, jeśli chodzi o najbardziej podstawowy układ magazynu."
	quest.7B74946F47392EFD.quest_subtitle: "Dokonaj 15 transakcji."
	quest.7B74946F47392EFD.title: "Kupiec"
	quest.7C19E4596E83ADF4.quest_desc: ["&o&#189502Jest to pierwszy i najpewniej jedyny ukryty quest. Gratuluję tego nietuzinkowego odkrycia"]
	quest.7C19E4596E83ADF4.quest_subtitle: "Wejdź na wyższy poziom poczucia humoru i wyposaż się w poduszkę pierdziuszkę."
	quest.7C19E4596E83ADF4.title: "Joe Mama"
	quest.7DC43D0D5586DB90.quest_subtitle: "Posmakuj każdego rodzaju wędki."
	quest.7DC43D0D5586DB90.title: "Żeby życie miało smaczek"
	quest.7E19081936904881.quest_desc: ["&o&#189502Centrifudge świadczący w sumie dwie funkcje. Jedna wymaga jednak dostępu do płynów, co potrzebne okaże się dopiero na późniejszych etapach zabawy z modem."]
	quest.7E19081936904881.quest_subtitle: "Kolejną maszyną, którą powinieneś stworzyć jest Centrifuge. Póki wsadź do niej sproszkowany węgiel i przejdź do następnego questa."
	quest.7E9400805E84B4AD.quest_subtitle: "Stwórz Jewelcrafting Station. Biżuteria stworzona na tym stole nie służy wyłącznie dla okazania statusu. Chociaż nada się pewnie jako tarcza antyinflacyjna, jeśli zrobisz ją ze złota."
	quest.7E9400805E84B4AD.title: "Jubiler"
	quest.7E99455E22901076.quest_desc: ["&o&#189502Chyba, bo szczerze nie mam pojęcia jak to sprawdzić na Singleplayer."]
	quest.7E99455E22901076.quest_subtitle: "Koniec ze zmartwieniami o prywatność i bezpieczeństwo twoich zasobów. Stwórz Security Manager, który pozwoli ci na zabezpieczenie dostępu nieznajomych do twojego magazynu. Security Card to wymagany przedmiot, jeśli sam nie chcesz utracić dostępu do swych bogactw."
	quest.7E99455E22901076.title: "Fosa Security"
	quest.7F095C2212D8A451.quest_desc: ["&o&#189502Fun fact: robienie tej paczki przez 95% czasu jest przyjemne i wydaje się upośledzające."]
	quest.7F095C2212D8A451.quest_subtitle: "Zabij Wildfire - władcę blaze'ów, czy przynajmniej ich starszego brata."
	quest.7F0B7C900DCE8E7A.quest_desc: [
		"&o&#189502Nowe dane odblokowujesz poprzez oglądanie go przez lupę (lub brutalne morderstwo). Co ważne, lupa została znacznie poprawiona w swojej funkcjonalności - przypnij ją do paska i używaj domyślnie przyciskiem C. Przybliżenie dostosować możesz scrollem."
		"&4Obecnie Wildex nie funkcjonuje, jak powinien - lupa używana ze slota paska nie identyfikuje nieodkrytych mobów. Jeśli chcesz więc używać jej w tym celu (co polecam), nie umieszczaj jej w tym slocie"
	]
	quest.7F0B7C900DCE8E7A.quest_subtitle: "@Wildex dodaje do gry encyklopedię wszelkich mobów (również tych z modów). Bardzo przydatne np. jeśli zastanawiasz się czy dany zwierzak jest oswajalny lub czym go rozmnożyć."
	quest.7F0B7C900DCE8E7A.title: "Chuj, póki gorące"
	quest.7F82D2ED6DAE78BD.quest_subtitle: "Stwórz Fragment Forge. Jedną z maszyn, które wyciągną więcej z twoich wykopalisk bez dodatkowych kosztów."
	quest.7F82D2ED6DAE78BD.title: "Tarka industrialna"
	quest.7FEFC0C65E5F773F.quest_desc: ["&o&#189502Obecny zasięg wydaje się być niewystarczający? Masz dwie opcje: Pierwszą jest po prostu dodanie ulepszenia do obecnego transmitera, co zwiększy jego zasięg z 16 do 24. Jeśli to nie wydaje się satysfakcjonujące, spróbuj dodać do swojej sieci dodatkowy Controller (umieszczony nieco dalej) oraz umieść na nim kolejny Wireless Transmitter."]
	quest.7FEFC0C65E5F773F.quest_subtitle: "Uskutecznij wydajność twojego bezprzewodowego łącznika."
	reward_table.08DC6CF8B0273992.title: "jajka"
